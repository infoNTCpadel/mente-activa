<h1>🔒 Panel del animador</h1>
<p class="sub">Esta zona es solo para el personal del centro.</p>
<form method="get" action="/panel" class="form-codigo">
  <label for="codigo">Código del centro</label>
  <input id="codigo" name="codigo" type="text" inputmode="numeric" autocomplete="off" placeholder="Escribe el código">
  <button class="btn" type="submit">Entrar</button>
</form>
